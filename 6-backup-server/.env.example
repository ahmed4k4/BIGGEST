# اتصال قاعدة Supabase المباشر (Direct connection) — لأخذ النسخة الاحتياطية بـ pg_dump
SOURCE_DATABASE_URL=
# رابط الـ API وتوكن جهاز من نوع server_agent (لوحة الإدارة ← الأجهزة)
CLOUD_URL=
DEVICE_TOKEN=
# مكان حفظ النسخ والتصديرات (يفضَّل قرص خارجي)
BACKUP_DIR=./data
# اختياري: قاعدة PostgreSQL محلية بصلاحية create database لاختبار استعادة كل نسخة تلقائيًا
# ADMIN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
# ساعة النسخ اليومي بتوقيت القاهرة (افتراضي 3) ويوم التصدير الأسبوعي (0=الأحد … 5=الجمعة)
# BACKUP_HOUR=3
# EXPORT_DAY=5
# رابط webhook للتنبيهات (Slack/Discord) — اختياري
# ALERT_WEBHOOK=
