# ===== للتشغيل على Node (جهاز/سيرفر خاص أو للتجربة) =====
# قاعدة البيانات: اتصال PostgreSQL مباشر (يلزم أداة psql على الجهاز)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/biggest
# أو Supabase بدلًا من DATABASE_URL:
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_KEY=            # سرّي جدًا: لا يوضع في أي متصفح

COMPANY_ID=00000000-0000-4000-8000-000000000001
# سرّ توقيع جلسات الإدارة (32 حرفًا على الأقل). ولّده: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_SECRET=غيّر-هذا-السر-قبل-أي-استخدام-حقيقي-000000
# المواقع المسموح لها باستدعاء الـ API (افصل بفاصلة). * للتجربة فقط
ALLOWED_ORIGINS=*
PORT=8787
# كلمات سر المستخدمين التجريبيين (seed-dev)
# SEED_OWNER_PASSWORD=
# SEED_ADMIN_PASSWORD=
